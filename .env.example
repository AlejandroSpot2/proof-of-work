# Copy to .env.local. Leave values empty to run in fixture mode (EXAMPLE data, no network, no model).

# Model for live mode, as "<provider>:<model-id>". Providers: anthropic, openai.
AI_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Raises the GitHub public API rate limit. Read-only, no scopes needed.
GITHUB_TOKEN=

# SQLite file path (local only today).
DATABASE_PATH=./data/proof-of-work.db
